# Compressie, caching en 301-redirects voor crossfitbergenopzoom.nl.
# SiteGround draait Apache achter nginx, dus .htaccess werkt hier gewoon.

# --- compressie ---------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- caching ------------------------------------------------------------
# Foto's en iconen veranderen alleen onder een nieuwe bestandsnaam, dus die
# mogen lang blijven staan. De pagina zelf niet: die moet een deploy meteen
# laten zien.
<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|webp|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=600, must-revalidate"
  </FilesMatch>
</IfModule>

# --- 404 ----------------------------------------------------------------
ErrorDocument 404 /404.html

# --- 301-redirects ------------------------------------------------------
RewriteEngine On

RewriteRule "^wat-is-crossfit/?$" "/#crossfit" [R=301,L,NE]
RewriteRule "^de-crossfit-methode/?$" "/#community" [R=301,L,NE]
RewriteRule "^is-crossfit-iets-voor-mij/?$" "/#faq" [R=301,L,NE]
RewriteRule "^lessen/?$" "/#programmas" [R=301,L,NE]
RewriteRule "^lessen/kids-training/?$" "/#crossfit-kids" [R=301,L,NE]
RewriteRule "^lessen/personal-training/?$" "/#private-coaching" [R=301,L,NE]
RewriteRule "^lessen/90-days-challenge/?$" "/#tarieven" [R=301,L,NE]
RewriteRule "^fitness/?$" "/#circuittraining" [R=301,L,NE]
RewriteRule "^trainers/?$" "/#founder" [R=301,L,NE]
RewriteRule "^tarieven/?$" "/#tarieven" [R=301,L,NE]
RewriteRule "^contact/?$" "/#contact" [R=301,L,NE]
RewriteRule "^binnenkort-beschikbaar/?$" "/#rooster" [R=301,L,NE]
RewriteRule "^category/uncategorized/?$" "/" [R=301,L,NE]
RewriteRule "^feed/?$" "/" [R=301,L,NE]
RewriteRule "^comments/feed/?$" "/" [R=301,L,NE]

# losse post-feeds
RewriteRule "^.+/feed/?$" "/" [R=301,L,NE]
